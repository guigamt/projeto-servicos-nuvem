{
  "name": "Projeto Servicos de Nuvem",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "latest", "helm": "none" }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [8080, 8081],
  "portsAttributes": {
    "8080": { "label": "Etapa 1 - NGINX (Docker Compose)" },
    "8081": { "label": "Etapas 2 e 3 - Ingress (Kubernetes)" }
  },
  "postCreateCommand": "bash scripts/preparar-ambiente.sh"
}
